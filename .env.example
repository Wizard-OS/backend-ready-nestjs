# App
NODE_ENV=development
PORT=3000
HOST_API=http://localhost:3000/api
JWT_SECRET=change_this_secret
INTEGRATION_TOKEN_ENCRYPTION_KEY=change_this_storage_integration_secret
ENABLE_SEED_ENDPOINT=false

# Country metadata - Rest Countries v5
# REST_COUNTRIES_BASE_URL=https://api.restcountries.com/countries/v5
# REST_COUNTRIES_API_KEY=

# Database
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=DentalHubDB
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false

# TypeORM
DB_SYNCHRONIZE=true

# Billing - PayPal Subscriptions
# PAYPAL_ENV=sandbox # sandbox | live
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_BRAND_NAME=Dental Hub
